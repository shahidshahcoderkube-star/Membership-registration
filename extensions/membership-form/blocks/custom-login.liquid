<div class="custom-login-wrapper" id="custom-login-wrapper">
  <div id="login-message" class="login-message hidden"></div>
  
  <div class="login-container">
    <h2 class="login-title">Login</h2>
    <p class="login-subtitle">Enter your email to continue</p>
    
    <form id="custom-login-form" data-shop="{{ shop.domain }}">
      <div class="form-group">
        <input type="email" id="login-email" name="email" placeholder="Email Address *" required>
      </div>
      <button type="submit" class="btn-login-submit" id="login-submit-btn">Continue</button>
    </form>
  </div>
</div>

<style>
.custom-login-wrapper {
  max-width: 450px;
  margin: 40px auto;
  padding: 30px;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.login-title {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 8px;
  text-align: center;
}
.login-subtitle {
  font-size: 14px;
  color: #666;
  margin-bottom: 25px;
  text-align: center;
}
.form-group {
  margin-bottom: 20px;
}
.form-group input {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #e1e3e5;
  border-radius: 6px;
  font-size: 16px;
  box-sizing: border-box;
}
.btn-login-submit {
  width: 100%;
  padding: 14px;
  background-color: #000;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s;
}
.btn-login-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.login-message {
  padding: 12px;
  border-radius: 6px;
  margin-bottom: 20px;
  font-size: 14px;
  text-align: center;
}
.login-message.error {
  background-color: #fff1f0;
  color: #d85140;
  border: 1px solid #ffa39e;
}
.hidden { display: none; }
</style>

<script>
document.getElementById('custom-login-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('login-email').value;
  const submitBtn = document.getElementById('login-submit-btn');
  const messageDiv = document.getElementById('login-message');

  submitBtn.disabled = true;
  submitBtn.innerText = 'Checking...';
  messageDiv.classList.add('hidden');

  try {
    // API Call to check if email is registered
    const response = await fetch('/apps/membership/check-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    });

    const data = await response.json();

    if (data.success && data.registered) {
      // Step 2 & 3: Registered -> Redirect to Shopify Login with vetted flag
      window.location.href = '/account/login?vetted=true&email=' + encodeURIComponent(email);
    } else {
      // Step 2: Not Registered -> Error and Link to Register
      messageDiv.innerHTML = "Email not found. Please <a href='/pages/membership-registration' style='color: #d85140; font-weight: bold;'>Register Here</a> first.";
      messageDiv.classList.remove('hidden');
      messageDiv.classList.add('error');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Continue';
    }
  } catch (error) {
    console.error('Error:', error);
    messageDiv.innerText = "System error. Please try again.";
    messageDiv.classList.remove('hidden');
    messageDiv.classList.add('error');
    submitBtn.disabled = false;
    submitBtn.innerText = 'Continue';
  }
});
</script>

{% schema %}
{
  "name": "Custom Login Form",
  "target": "section",
  "settings": []
}
{% endschema %}
